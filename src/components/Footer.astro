---
import { site, services, locations } from "../data/site";
const year = new Date().getFullYear();

const testimonials = [
  {
    quote: "Elevation handled our annual NFPA 25 inspection across four properties without any scheduling headaches. Reports were clean, AHJ-ready, and in our inbox the same day.",
    name: "Mark T.",
    title: "Property Manager, Denver",
  },
  {
    quote: "We had a freeze break at 11 PM on a Tuesday. They answered, dispatched, and had the system repaired and back in service before morning. Can't ask for more than that.",
    name: "Sarah K.",
    title: "Facility Director, Aurora",
  },
  {
    quote: "As a GC, I need a fire sprinkler sub that hits the schedule and doesn't create problems at inspection. Elevation has been that contractor on every project we've run together.",
    name: "James R.",
    title: "General Contractor, Front Range",
  },
];
---
<footer class="bg-brand-deep text-white w-full border-t border-white/10 flex flex-col gap-8 px-6 py-12">

  <!-- Testimonials -->
  <div class="max-w-7xl mx-auto w-full">
    <div class="flex flex-col gap-2 mb-8">
      <span class="text-label-caps uppercase font-bold text-brand-accent tracking-wider text-sm">What Our Customers Say</span>
      <div class="w-12 h-0.5 bg-brand-accent"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <div class="bg-white/5 border border-white/10 rounded p-6 flex flex-col gap-4">
          <div class="flex gap-1">
            {[...Array(5)].map(() => (
              <span class="text-brand-accent text-sm">★</span>
            ))}
          </div>
          <p class="text-slate-300 text-sm leading-relaxed italic">"{t.quote}"</p>
          <div class="mt-auto pt-4 border-t border-white/10">
            <p class="text-white font-semibold text-sm">{t.name}</p>
            <p class="text-slate-400 text-xs">{t.title}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="max-w-7xl mx-auto w-full border-t border-white/10"></div>
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-4 gap-12">
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="" class="h-12 w-auto bg-white p-1 rounded" width="48" height="48" />
        <span class="text-lg font-black text-white uppercase tracking-tight">{site.brand}</span>
      </div>
      <p class="text-slate-300 text-sm max-w-xs">
        Locally owned fire sprinkler contractor protecting commercial assets across Colorado and Wyoming since {site.founded}.
      </p>

    </div>
    <div class="flex flex-col gap-4">
      <h4 class="font-bold text-white uppercase tracking-wider text-sm">Services</h4>
      <nav class="flex flex-col gap-2">
        {services.map((s) => (
          <a class="text-slate-300 hover:text-brand-accent transition-colors text-sm" href={`/services/${s.slug}/`}>{s.name}</a>
        ))}
      </nav>
    </div>
    <div class="flex flex-col gap-4">
      <h4 class="font-bold text-white uppercase tracking-wider text-sm">Service Area</h4>
      <nav class="flex flex-col gap-2">
        {locations.map((l) => (
          <a class="text-slate-300 hover:text-brand-accent transition-colors text-sm" href={`/locations/${l.slug}/`}>{l.city}, {l.stateCode}</a>
        ))}
      </nav>
    </div>
    <div class="flex flex-col gap-4">
      <h4 class="font-bold text-white uppercase tracking-wider text-sm">24/7 Emergency</h4>
      <div class="p-4 bg-white/5 border border-white/10 rounded">
        <p class="text-sm text-slate-300 mb-2">Available anytime, day or night.</p>
        <a class="text-xl font-bold text-brand-accent" href={site.phoneTel}>{site.phoneDisplay}</a>
        <a class="block text-sm text-slate-300 hover:text-brand-accent transition-colors mt-2" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto w-full pt-8 border-t border-white/5 text-center">
    <p class="text-slate-400 text-xs">© {year} {site.brand}. Licensed &amp; Insured.</p>
  </div>
</footer>
