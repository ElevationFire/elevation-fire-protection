---
import { site, services, locations } from "../data/site";

interface Props {
  pageUrl: string;
}
const { pageUrl } = Astro.props;

const businessId = `${site.url}/#business`;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Plumber"],
  "@id": businessId,
  name: site.brand,
  legalName: site.legalName,
  url: site.url,
  telephone: site.phoneE164,
  email: site.email,
  description: site.description,
  image: `${site.url}/logo.png`,
  logo: `${site.url}/logo.png`,
  priceRange: "$$",
  foundingDate: site.founded,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: site.hours.map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.day,
    opens: h.opens,
    closes: h.closes,
  })),
  areaServed: locations.map((l) => ({
    "@type": "City",
    name: l.city,
    address: { "@type": "PostalAddress", addressRegion: l.stateCode, addressCountry: "US" },
  })),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Fire Protection Services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.name, url: `${site.url}/services/${s.slug}/` },
    })),
  },
  sameAs: [],
};

const webPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: pageUrl,
  isPartOf: { "@id": businessId },
};
---
<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
<script type="application/ld+json" set:html={JSON.stringify(webPage)} />
