---
import { site } from "../data/site";
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  pageUrl: string;
}
const { title, description, pubDate, updatedDate, author, pageUrl } = Astro.props;
const isOrg = author === site.brand;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: "en-US",
  image: `${site.url}/logo.png`,
  author: isOrg
    ? { "@type": "Organization", name: author, url: site.url }
    : { "@type": "Person", name: author, worksFor: { "@id": `${site.url}/#business` } },
  publisher: {
    "@type": "Organization",
    name: site.brand,
    url: site.url,
    logo: { "@type": "ImageObject", url: `${site.url}/logo.png` },
  },
  url: pageUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
