---
import Layout from "../layouts/Layout.astro";
import { site, services, locations } from "../data/site";

const title = `${site.brand} | Fire Sprinkler Service in Denver, CO`;
const description = site.description;
---
<Layout title={title} description={description} canonicalPath="/">
  <!-- Hero Section -->
  <section class="relative bg-primary-container overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-gradient-to-br from-primary to-transparent"></div>
      <img class="w-full h-full object-cover" alt="Fire protection technician inspecting a commercial fire pump." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAc3AIMy1Xr-emjHizO8QuaaEdrzYHV6S2Dt1MGomhX9xzJLljXHehGmuik7ioUv63aBKP5Ug00mxe7muvxqyMcAH7iF7bxxIo8qhwpq_Q4LF6xNxTH8Rv8lrpUYK9Y9sagLgyoP7o4DVnHJCVbKOUBhvyFULr6wg_PGmcpuIy0lIty2eqf7hP4yNLTsME8nCc5pBjbUoOLdapD4TRZJ03-rdli3LYoz3b_0JFr28MH5YV7z-CmJ-uH6oyZauxyWN7spXG4SRC1V8TO" loading="eager" />
    </div>
    <div class="relative px-6 py-16 md:py-24 max-w-7xl mx-auto flex flex-col items-start gap-6">
      <span class="inline-block px-3 py-1 bg-secondary-container text-on-secondary-container text-label-caps uppercase rounded font-bold">Locally Owned · Denver</span>
      <h1 class="text-h1 font-bold text-white max-w-2xl">{site.yearsExperience} Years of Expert Fire Protection</h1>
      <p class="text-body-lg text-on-primary-container max-w-xl">
        Locally owned and operated. Providing reliable, life-safety solutions across Colorado and Wyoming with technical mastery and unshakeable commitment.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a href={site.phoneTel} class="bg-brand-accent text-primary-container text-h3 font-semibold py-4 px-8 rounded shadow-lg active:scale-95 transition-transform inline-block text-center">
          Request Inspection
        </a>
        <a href="#services" class="border-2 border-brand-accent text-brand-accent text-h3 font-semibold py-4 px-8 rounded active:scale-95 transition-transform inline-block text-center">
          Our Services
        </a>
      </div>
    </div>
  </section>

  <!-- Specialized Services Grid -->
  <section id="services" class="px-6 py-16 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col gap-2 mb-10">
        <span class="text-secondary text-label-caps uppercase font-bold">Our Expertise</span>
        <h2 class="text-h2 font-bold text-primary-container">Specialized Services</h2>
        <div class="w-16 h-1 bg-secondary"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="border border-outline-variant p-6 flex flex-col gap-4 group hover:border-secondary transition-colors">
            <span class="material-symbols-outlined text-brand-deep text-4xl">{s.icon}</span>
            <h3 class="text-h3 font-semibold text-primary-container">{s.name}</h3>
            <p class="text-on-surface-variant">{s.short}</p>
            <span class="text-secondary text-label-caps uppercase font-bold mt-auto">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The Elevation Advantage -->
  <section class="px-6 py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row gap-12 items-center">
      <div class="w-full md:w-1/2">
        <div class="relative rounded-lg overflow-hidden border-2 border-white shadow-xl">
          <img class="w-full aspect-video object-cover" alt="Denver skyline at dusk with the Rocky Mountains in the background." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAzdArE_tWmcQqjewn9u69zEENNw6SFYTx7m65w5Bjb5RO9PZhpDVHwXnZwZXPlhxBKu6n0mU9WvMX7vzo4lFa1XwXXR5He7vSMKM8RKvh8clhHM506j7-VglWi9gx5YVhyDdtdE5zXkD9CsSGtBmIvu_TE0YJn6_lQjr0aUsZUT4vumYTS4rjrZE283Ry5ApjpAbzgtEYs9dHThuAdz21kaH55uyJ9T_gfd6Fk_fsxAyKxaDr4mkWy_4R6kFRYEaYxZB-o26FGDORH" loading="lazy" />
        </div>
      </div>
      <div class="w-full md:w-1/2 flex flex-col gap-6">
        <h2 class="text-h2 font-bold text-primary-container">The Elevation Advantage</h2>
        <div class="flex flex-col gap-8">
          <div class="flex gap-4">
            <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">location_on</span>
            <div>
              <h3 class="text-h3 font-semibold text-primary-container">Locally Owned</h3>
              <p class="text-on-surface-variant">We aren't a national conglomerate. We are your neighbors, committed to protecting our local community.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">speed</span>
            <div>
              <h3 class="text-h3 font-semibold text-primary-container">Faster Dispatch</h3>
              <p class="text-on-surface-variant">Strategic positioning across the Front Range allows us to reach your facility in record time.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="material-symbols-outlined text-secondary" style="font-variation-settings: 'FILL' 1;">engineering</span>
            <div>
              <h3 class="text-h3 font-semibold text-primary-container">In-house Engineering</h3>
              <p class="text-on-surface-variant">From design to implementation, our in-house team handles the technical complexity so you don't have to.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="px-6 py-16 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col gap-2 mb-10">
        <span class="text-secondary text-label-caps uppercase font-bold">Service Area</span>
        <h2 class="text-h2 font-bold text-primary-container">Colorado &amp; Wyoming</h2>
        <div class="w-16 h-1 bg-secondary"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {locations.map((l) => (
          <a href={`/locations/${l.slug}/`} class="border border-outline-variant p-4 hover:border-secondary transition-colors flex flex-col gap-1">
            <span class="text-label-caps uppercase font-bold text-secondary">{l.stateCode}</span>
            <span class="text-h3 font-semibold text-primary-container">{l.city}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- For General Contractors -->
  <section class="px-6 py-16 bg-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col gap-2 mb-10">
        <span class="text-secondary text-label-caps uppercase font-bold">For General Contractors</span>
        <h2 class="text-h2 font-bold text-primary-container">Build Partner, Not Bottleneck</h2>
        <div class="w-16 h-1 bg-secondary"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-6">
        <div class="border border-outline-variant p-6 flex flex-col gap-3 sm:col-span-2 lg:col-span-2 bg-white">
          <span class="material-symbols-outlined text-brand-deep text-4xl">handshake</span>
          <h3 class="text-h3 font-semibold text-primary-container">GC Partnership</h3>
          <p class="text-on-surface-variant flex-grow">
            We work with GCs across the Front Range on tenant improvements and new construction — full in-house design, stamped permit drawings, and a crew that hits your schedule without subbing the work out.
          </p>
          <a href={site.phoneTel} class="bg-brand-accent text-primary-container text-h3 font-semibold py-3 px-6 rounded shadow-lg active:scale-95 transition-transform inline-block text-center mt-2">
            Talk to Us About Your Project
          </a>
        </div>
        <div class="border border-outline-variant p-6 flex flex-col gap-3 bg-white">
          <span class="material-symbols-outlined text-brand-deep text-4xl">domain</span>
          <h3 class="text-h3 font-semibold text-primary-container">Tenant Improvements</h3>
          <p class="text-on-surface-variant">Build-outs and TI sprinkler work scheduled around your trades, signed off in time for occupancy.</p>
        </div>
        <div class="border border-outline-variant p-6 flex flex-col gap-3 bg-white">
          <span class="material-symbols-outlined text-brand-deep text-4xl">construction</span>
          <h3 class="text-h3 font-semibold text-primary-container">New Construction</h3>
          <p class="text-on-surface-variant">Ground-up commercial and residential sprinkler installation, from underground fire line to final AHJ walkthrough.</p>
        </div>
        <div class="border border-outline-variant p-6 flex flex-col gap-3 bg-white">
          <span class="material-symbols-outlined text-brand-deep text-4xl">draw</span>
          <h3 class="text-h3 font-semibold text-primary-container">In-House Design</h3>
          <p class="text-on-surface-variant">Hydraulic calcs and stamped permit drawings done by our own team — no third-party engineering delays.</p>
        </div>
        <div class="border border-outline-variant p-6 flex flex-col gap-3 bg-white">
          <span class="material-symbols-outlined text-brand-deep text-4xl">schedule</span>
          <h3 class="text-h3 font-semibold text-primary-container">On Schedule</h3>
          <p class="text-on-surface-variant">Locally owned means we move when you move. No corporate dispatch queue between your project manager and our crew.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section class="px-6 py-12 bg-white border-y border-outline-variant">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-label-caps uppercase font-bold text-outline mb-8">Trusted by Industry Leaders</p>
      <div class="flex flex-wrap justify-center items-center gap-12 opacity-60 grayscale hover:grayscale-0 transition-all">
        <span class="text-h2 font-bold text-primary-container tracking-tighter">CBRE</span>
        <span class="text-h2 font-bold text-primary-container tracking-tighter">CAESARS</span>
        <span class="text-h2 font-bold text-primary-container tracking-tighter">SOPRA</span>
        <div class="flex items-center gap-2 border-l border-outline-variant pl-12">
          <span class="material-symbols-outlined text-secondary text-4xl" style="font-variation-settings: 'FILL' 1;">verified</span>
          <div class="text-left">
            <p class="text-label-caps uppercase font-bold text-primary-container">LICENSED &amp;</p>
            <p class="text-label-caps uppercase font-bold text-primary-container">INSURED</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
